{$API_DOMAIN} {
    request_body { max_size 31MB }
    reverse_proxy api:4000
}
{$ADMIN_DOMAIN} {
    root * /srv/folio-admin
    try_files {path} /index.html
    file_server
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'self'; connect-src 'self' https://{$API_DOMAIN}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; frame-ancestors 'none'"
    }
}
