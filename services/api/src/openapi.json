{
  "openapi": "3.1.0",
  "info": {
    "title": "Folio API",
    "version": "0.1.0",
    "description": "All protected resources are owner-scoped. Refresh tokens rotate on use; replay revokes the token family. PDFs are transferred through short-lived signed URLs."
  },
  "servers": [
    {
      "url": "http://localhost:4000/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        }
      },
      "Register": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Credentials"
          },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        ]
      },
      "DocumentInput": {
        "type": "object",
        "required": ["id", "title", "pageCount"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "pageCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "favorite": {
            "type": "boolean"
          },
          "folderId": {
            "type": ["string", "null"],
            "format": "uuid"
          }
        }
      },
      "DocumentPatch": {
        "type": "object",
        "required": ["revision"],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "pageCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "favorite": {
            "type": "boolean"
          },
          "folderId": {
            "type": ["string", "null"]
          }
        }
      },
      "UploadInput": {
        "type": "object",
        "required": ["documentId", "fileSize", "mimeType", "revision"],
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "fileSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 104857600
          },
          "mimeType": {
            "const": "application/pdf"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Purchase": {
        "type": "object",
        "required": ["platform", "productId", "purchaseToken"],
        "properties": {
          "platform": {
            "enum": ["android", "ios"]
          },
          "productId": {
            "type": "string"
          },
          "purchaseToken": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "POST /auth/register",
        "tags": ["auth"],
        "responses": {
          "200": {
            "description": "Operation result"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing, expired or revoked authentication"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Not found or not owned by caller"
          },
          "409": {
            "description": "Revision conflict or duplicate record"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Provider not configured"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
