    "express-rate-limit": "^8.0.0",
    "google-auth-library": "^10.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.18.0",
