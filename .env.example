NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/folio?replicaSet=rs0&directConnection=true
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=folio
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
# Optional: identity provider configuration
GOOGLE_CLIENT_ID=
GOOGLE_PACKAGE_NAME=app.folio.scanner
# JSON credentials; keep outside source control. Prefer a secret manager in production.
GOOGLE_SERVICE_ACCOUNT=
PREMIUM_PRODUCT_IDS=folio.premium.monthly
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE=
# Mobile: copy to apps/mobile/.env. Use your LAN IP on a real device.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Admin: copy to apps/admin/.env
VITE_API_URL=http://localhost:4000
# Billing must stay disabled until sandbox verification and store setup pass.
EXPO_PUBLIC_BILLING_ENABLED=false
# Apple App Store Server API; uncomment only after configuring real values.
# APPLE_KEY_ID=
# APPLE_ISSUER_ID=
# APPLE_BUNDLE_ID=app.folio.scanner
# APPLE_APP_ID=123456789
# APPLE_PRIVATE_KEY_BASE64=
# APPLE_ROOT_CA_PATHS=/run/secrets/AppleRootCA-G3.cer,/run/secrets/AppleRootCA-G2.cer
APPLE_ENVIRONMENT=Production
